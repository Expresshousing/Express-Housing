MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=express_housing
JWT_SECRET=replace-with-a-long-random-secret
# Must list every origin the frontend is actually served from, port included.
# A missing origin fails only in the browser: the API answers curl normally while
# every request from the page is blocked, so the site loads but shows no data.
# Serving a production build on another port (e.g. :3001) needs that origin added.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO_DATA=false
SEED_PORTFOLIO_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ACCESS_ENCRYPTION_KEY=replace-with-a-fernet-key
# Optional. Get a key at https://resend.com — leave blank to keep emails mocked/logged-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Express Housing <onboarding@resend.dev>
